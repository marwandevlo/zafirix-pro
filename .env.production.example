# ZAFIRIX PRO — Vercel Production environment template
# Copy keys/values into Vercel → Project → Settings → Environment Variables → Production

NEXT_PUBLIC_APP_URL=https://www.zafirixpro.com
NEXT_PUBLIC_SITE_URL=https://www.zafirixpro.com
NEXT_PUBLIC_PORTAL_URL=https://portal.zafirixpro.ma
NEXT_PUBLIC_PORTAL_HOST=portal.zafirixpro.ma

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_ATLAS_DATA_BACKEND=supabase
# Client portal — enabled by default; set to false only to disable public /portal routes
NEXT_PUBLIC_ENABLE_CLIENT_PORTAL=true
NEXT_PUBLIC_ENABLE_CLIENT_PORTAL_DEMO=false

ANTHROPIC_API_KEY=

# Sentry (optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
