# ZAFIRIX PRO — copy to `.env.local` for development. Set the same keys in Vercel (Production / Preview).

# ── Production domains (Vercel Production — no trailing slash) ─────────────────
# Main app (dashboard, auth, emails):
#   NEXT_PUBLIC_APP_URL=https://www.zafirixpro.com
#   NEXT_PUBLIC_SITE_URL=https://www.zafirixpro.com
# Optional dedicated client portal subdomain (same Next.js deployment, custom domain in Vercel):
#   NEXT_PUBLIC_PORTAL_URL=https://portal.zafirixpro.ma
#   NEXT_PUBLIC_PORTAL_HOST=portal.zafirixpro.ma
# Local development:
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Optional client portal subdomain (rewrites portal.zafirixpro.ma/{code} → /portal/{code})
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_PORTAL_HOST=

# Supabase (public; safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database migration runner — session pooler (IPv4). Do NOT use db.*.supabase.co direct host.
# SUPABASE_POOLER_REGION=eu-west-1
# SUPABASE_DB_PASSWORD=           # Supabase → Settings → Database (builds pooler URL automatically)
# SUPABASE_ACCESS_TOKEN=          # https://supabase.com/dashboard/account/tokens (alternative)
# DATABASE_URL=                   # Auto-rewritten to pooler if direct host is used
#
# Production: npm run apply:production-migrations  (AI tables + enterprise modules + RLS)

# Data backend — use supabase in Vercel Production (NODE_ENV=production also forces supabase).
NEXT_PUBLIC_ATLAS_DATA_BACKEND=supabase

# Client Portal — enabled by default; set NEXT_PUBLIC_ENABLE_CLIENT_PORTAL=false to disable
# Share link format: {PORTAL_URL}/portal/{companyCode} or portal.zafirixpro.ma/{companyCode}
# Fallback codes: explicit clientPortalCode → slugified company name → company-{id}
NEXT_PUBLIC_ENABLE_CLIENT_PORTAL=true
NEXT_PUBLIC_ENABLE_CLIENT_PORTAL_DEMO=false
CLIENT_PORTAL_DEMO_CODE=1234
CLIENT_PORTAL_DEMO_COMPANY_ID=
CLIENT_PORTAL_DEMO_OWNER_USER_ID=

# Anthropic — SERVER-SIDE ONLY. Required for /consultant, /api/ai, OCR.
ANTHROPIC_API_KEY=

# Google Drive backup (Centre de sauvegarde + Quick Share)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Email dispatch (Resend) — account notifications, documents, lifecycle
# EMAIL_API_KEY is accepted as an alias of RESEND_API_KEY
RESEND_API_KEY=
EMAIL_API_KEY=
RESEND_FROM_EMAIL=ZAFIRIX PRO <noreply@zafirixpro.com>
